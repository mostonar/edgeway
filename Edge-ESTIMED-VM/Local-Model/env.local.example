# env.local.example
#
# 실제 주소는 이 저장소에 두지 않는다. 공개 저장소이기 때문이다.
# 이 파일을 .env.local 로 복사해서 값을 채운다. 실행 스크립트는 이 폴더의
# .env.local 을 먼저 찾고, 없으면 저장소 루트의 .env.local 을 읽는다.
# 한 호스트에 폴더가 여럿이면 저장소 루트에 하나만 둬도 된다.
#
#   cp Edge-ESTIMED-VM/Local-Model/env.local.example Edge-ESTIMED-VM/Local-Model/.env.local
#   # 값 채우기
#   Cloud 호스트:     bash Cloud/FL-FedAvg/run_fedavg.sh
#   Edge VM:          bash Edge-ESTIMED-VM/Local-Model/run_local_model.sh / bash FL-Dashboard/run_dashboard.sh
#
# 폴더마다 필요한 값
#   Cloud/FL-FedAvg               FL_IN_BASE_URL, FL_IN_CSE_NAME (+ FL_IN_USER / FL_IN_PASS)
#   FL-Dashboard                  위 IN 값 + FL_SANDBOX_HOST, FL_SANDBOX_NAME
#   Edge-ESTIMED-VM/Local-Model   위 IN 값 + FL_SANDBOX_HOST, FL_SANDBOX_NAME, FL_NOTIFY_HOST
#
# .gitignore 가 .env* 를 막으므로 .env.local 은 커밋되지 않는다.
# (이 예시 파일은 그래서 점 없이 env.local.example 이다)

# ── 필수 ────────────────────────────────────────────────

# MEC 샌드박스가 떠 있는 호스트.
# 실행 위치에 따라 다르다.
#   유선망            연구실 공인 IP
#   같은 공유기 Wi-Fi  192.168.x.x
#   테일넷            100.x.x.x   (Isaac Sim PC도 테일넷이면 이쪽)
export FL_SANDBOX_HOST=

# 샌드박스 인스턴스 이름. 샌드박스를 다시 만들면 바뀐다.
export FL_SANDBOX_NAME=

# IN-CSE는 샌드박스 밖(클라우드)에 있어 주소를 따로 준다.
# 샌드박스의 MN-CSE 3개는 FL_SANDBOX_HOST 에서 유추되므로 지정할 필요가 없다.
export FL_IN_BASE_URL=
export FL_IN_CSE_NAME=

# IN-CSE가 HTTP 기본 인증을 요구하면 채운다 (401이 오면 필요하다는 뜻).
# edgeway.yaml 의 REMOTE_CSE_USER / REMOTE_CSE_PASS 와 같은 값이다.
# 이 파일은 .gitignore 로 막혀 있으니 커밋되지 않는다.
export FL_IN_USER=
export FL_IN_PASS=

# 사업장 MN-CSE 가 사업장 앱(포트 5001-5003)으로 알림을 보낼 주소. Edge 호스트에서 필요하다.
# MN-CSE 는 샌드박스 컨테이너 안이라 127.0.0.1 로는 닿지 않는다. 이 호스트의 IP 를 넣는다.
export FL_NOTIFY_HOST=

# ── 선택 ────────────────────────────────────────────────

# 띄울 판정 앱 (Edge 호스트). 기본 A,B,C. 비우면 판정 앱 없이 돈다.
# export JUDGE_SITES=A,B,C
# judge_ae.py 가 있는 폴더. 기본은 Edge-ESTIMED-VM/Local-Model/judge_ae
# export JUDGE_AE_DIR=/path/to/judge_ae

# Cloud 호스트에서 샌드박스 MN-CSE 가 안 닿으면, IN-AE 시작 때의 ACP 점검을 끈다.
# export FL_VERIFY_ACP=0

# 샌드박스가 IP 기반 자체 서명 인증서를 쓰면 검증이 실패한다.
# 그때만 0으로 내린다. 끄면 중간자 공격을 막지 못한다.
# export FL_TLS_VERIFY=0

# CSE 주소를 직접 지정할 때 (샌드박스 경로 규칙을 안 따르는 배포)
# export FL_IN_BASE_URL=https://example/in
# export FL_IN_CSE_NAME=acme-cse-in-xxxx
# export FL_MN_BASE_URL_MN1=https://example/mep-a
# export FL_MN_CSE_NAME_MN1=acme-cse-mn-mep-a-xxxx

# 센서 데이터를 CSE가 아니라 로컬 pkl에서 읽는다 (오프라인 검증)
# export FL_SENSOR_FROM_CSE=0

# MEC011 에 등록할 학습 앱 주소(호스트). 등록 정보로만 쓰인다.
# FL_NOTIFY_HOST 는 oneM2M 알림(poa)에도 쓰이므로 그것과 따로 둔다.
# 비우면 FL_NOTIFY_HOST 를 쓴다. 포트는 run_local_model.sh 의 5001~5003 이다.
# export FL_MEC_APP_HOST=203.0.113.10

# MN-CSE 주소를 MEC033(IoT API)에서 받지 않고 주소 규칙만 쓸 때 0.
# FL_MN_BASE_URL_MN1 처럼 직접 주면 그게 먼저다.
# export FL_MEC_IOT=0

# MEC028 판정 문턱. 실측에 맞춰 조정한다.
# export FL_RSSI_WARN_DBM=-75
# export FL_RSSI_BAD_DBM=-85
# export FL_UL_MIN_KBPS=500
# export FL_CHU_WARN_PCT=70

# 오프라인 데이터 준비용 telemetry.json 위치
# export AMR_DATA=/path/to/telemetry
