# env.local.example
#
# Real addresses are not kept in this repo, because it is public.
# Copy this file to .env.local and fill in the values. Run scripts look for .env.local in this
# folder first, and if missing read .env.local at the repo root.
# If a host has several folders, a single one at the repo root is enough.
#
#   cp FL-Dashboard/env.local.example FL-Dashboard/.env.local
#   # Fill in values
#   host that reaches the IN-CSE:          bash Cloud/FL-FedAvg/run_fedavg.sh
#   host the site MN-CSEs can call back:   bash Edge-ESTIMED-VM/Local-Model/run_local_model.sh
#   admin host (reaches both):             bash FL-Dashboard/run_dashboard.sh
#
# Values needed per folder
#   Cloud/FL-FedAvg               FL_IN_BASE_URL, FL_IN_CSE_NAME (+ FL_IN_USER / FL_IN_PASS)
#   FL-Dashboard                  IN values above + FL_SANDBOX_HOST, FL_SANDBOX_NAME
#   Edge-ESTIMED-VM/Local-Model   IN values above + FL_SANDBOX_HOST, FL_SANDBOX_NAME, FL_NOTIFY_HOST
#
# .gitignore blocks .env*, so .env.local is never committed.
# (That is why this example file is env.local.example without a dot)

# ── Required ──────────────────────────────────────────────

# Host where the MEC sandbox is running.
# Depends on where it runs.
#   Wired network       lab public IP
#   Same router Wi-Fi  192.168.x.x
#   Tailnet            100.x.x.x   (use this if the Isaac Sim PC is also on the tailnet)
export FL_SANDBOX_HOST=

# Sandbox instance name. Changes when the sandbox is recreated.
export FL_SANDBOX_NAME=

# The IN-CSE is outside the sandbox (in the cloud), so its address is given separately.
# The sandbox's 3 MN-CSEs are inferred from FL_SANDBOX_HOST, so they need not be specified.
export FL_IN_BASE_URL=
export FL_IN_CSE_NAME=

# Fill in if the IN-CSE requires HTTP basic auth (a 401 means it does).
# Same values as REMOTE_CSE_USER / REMOTE_CSE_PASS in edgeway.yaml.
# This file is blocked by .gitignore, so it will not be committed.
export FL_IN_USER=
export FL_IN_PASS=

# Address the site MN-CSEs use to send notifications to the site apps (ports 5001-5003). Needed on the Edge host.
# The MN-CSE is inside the sandbox container, so 127.0.0.1 does not reach it. Put this host's IP.
export FL_NOTIFY_HOST=

# ── Optional ──────────────────────────────────────────────

# Judge apps to launch (Edge host). Default A,B,C. Leave empty to run without judge apps.
# export JUDGE_SITES=A,B,C
# Folder containing judge_ae.py. Default is Edge-ESTIMED-VM/Local-Model/judge_ae
# export JUDGE_AE_DIR=/path/to/judge_ae

# If the sandbox MN-CSEs are unreachable from the coordinator's host, turn off the ACP check at IN-AE startup.
# export FL_VERIFY_ACP=0

# If the sandbox uses an IP-based self-signed certificate, verification fails.
# Only then set it to 0. Turning it off leaves you open to man-in-the-middle attacks.
# export FL_TLS_VERIFY=0

# When specifying CSE addresses directly (deployments that do not follow the sandbox path rules)
# export FL_IN_BASE_URL=https://example/in
# export FL_IN_CSE_NAME=acme-cse-in-xxxx
# export FL_MN_BASE_URL_MN1=https://example/mep-a
# export FL_MN_CSE_NAME_MN1=acme-cse-mn-mep-a-xxxx

# Read sensor data from local pkl instead of the CSE (offline verification)
# export FL_SENSOR_FROM_CSE=0

# Training app address (host) to register with MEC011. Used only as registration info.
# FL_NOTIFY_HOST is also used for oneM2M notifications (poa), so this is kept separate.
# If empty, FL_NOTIFY_HOST is used. Ports are 5001~5003 from run_local_model.sh.
# export FL_MEC_APP_HOST=203.0.113.10

# 0 to use only the address rules instead of getting MN-CSE addresses from MEC033 (IoT API).
# A direct value like FL_MN_BASE_URL_MN1 takes precedence.
# export FL_MEC_IOT=0

# MEC028 decision threshold. Tune to measurements.
# export FL_RSSI_WARN_DBM=-75
# export FL_RSSI_BAD_DBM=-85
# export FL_UL_MIN_KBPS=500
# export FL_CHU_WARN_PCT=70

# Location of telemetry.json for offline data preparation
# export AMR_DATA=/path/to/telemetry
