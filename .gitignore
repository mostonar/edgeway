# ===== Secrets =====
# .env.local holds the IN-CSE account (FL_IN_USER / FL_IN_PASS). Never commit it.
# (The example file env.local.example does not start with a dot, so it is not caught here)
.env
.env.*

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/

# ===== Run artifacts =====
# Run scripts leave logs in logs/run_<timestamp>/ in each folder.
logs/
*.log
# Model / preprocessing artifacts (written to /tmp, but blocked here in case they land inside the repo)
*.pt
*.pth
*.pkl
