                            "raw": "{\n    \"subscriptionType\": \"ProvChgUuUniSubscription\",\n    \"callbackReference\": \"http://my.callback.com/vis/v2/notify\",\n    \"filterCriteria\": {\n        \"locationInfo\": {\n            \"ecgi\": {\n                \"cellId\": {\n                    \"cellId\": \"218959117\"\n                },\n                \"plmn\": {\n                    \"mcc\": \"1\",\n                    \"mnc\": \"1\"\n                }\n            }\n        }\n    }\n}"
