                {
                    "name": "POST subscriptions",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var responseJson = pm.response.json();",
                                    "if(responseJson._links && responseJson._links.self && responseJson._links.self.href) {",
                                    "    var href = responseJson._links.self.href;",
                                    "    var parts = href.split('/');",
                                    "    var subId = parts[parts.length - 1];",
                                    "    pm.environment.set(\"subscriptionId\", subId);",
                                    "    console.log(\"Saved subscriptionId: \" + subId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
