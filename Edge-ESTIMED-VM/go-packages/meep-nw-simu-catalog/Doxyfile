# Doxyfile for go-packages/meep-nw-simu-catalog
# Generate HTML:  doxygen Doxyfile
# Output:         doxygen/html/index.html

PROJECT_NAME           = "meep-nw-simu-catalog"
PROJECT_NUMBER         = "Round 5.3"
PROJECT_BRIEF          = "NEM catalog and instance client for ETSI MEC Sandbox"
OUTPUT_DIRECTORY       = doxygen
CREATE_SUBDIRS         = NO

INPUT                  = .
FILE_PATTERNS          = *.go *.dox
RECURSIVE              = NO
EXCLUDE_PATTERNS       = */doxygen/*

EXTENSION_MAPPING      = go=C++
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = YES

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
TAB_SIZE               = 8
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = AUTO_LIGHT
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

HAVE_DOT               = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = NO
WARN_LOGFILE           = doxygen/doxygen_warnings.log

ALIASES                += "go{1}=\\c \1"
